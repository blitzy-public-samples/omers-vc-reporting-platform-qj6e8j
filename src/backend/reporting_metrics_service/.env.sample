# This file provides a template for defining environment variables required for the service's operation.
# Requirement addressed: API Development and Deployment (Technical Requirements/Feature 2: API Development and Deployment)

# Specifies the environment in which the service is running (e.g., development, production)
# This value is used in src/backend/reporting_metrics_service/config.py to configure the application settings
ENVIRONMENT=development

# The connection string for the PostgreSQL database, used by SQLAlchemy to connect and perform ORM operations
# Replace user, password, localhost, and dbname with your actual database credentials and details
DATABASE_URL=postgresql://user:password@localhost/dbname

# Secret key used for signing/validating tokens. REQUIRED - no default is provided.
# Must be a strong, unique value of minimum 32 characters.
SECRET_KEY=<your-32-char-min-secret-key>

# Defines the logging level for the application (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Explicit, non-wildcard browser-origin allow-list for CORS (CWE-942), given as a JSON array.
# Validated fail-closed by config.py: a wildcard "*", an empty list, or a malformed origin is
# rejected and the service will not start. If unset, config.py falls back to a safe localhost list.
# Example (override with your real front-end origins per environment):
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://localhost:3000"]