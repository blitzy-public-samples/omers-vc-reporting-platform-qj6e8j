# This file provides a template for configuring environment-specific settings required by the service.

# Database Configuration
# Replace with your actual PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost/dbname

# API Configuration
# Replace with your actual API key for external services (if applicable)
API_KEY=your_api_key_here

# Logging Configuration
# Set the desired log level (e.g., debug, info, warning, error, critical)
LOG_LEVEL=info

# CORS Configuration
# Explicit, non-wildcard allow-list of browser origins permitted to call this API (CWE-942).
# config.py provides a safe localhost default, so this is OPTIONAL. When overriding, use a
# comma-separated list of origins -- the convention shared with the API gateway and
# reporting-financials services -- e.g.
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
# A JSON array (e.g. ["https://app.example.com"]) is also accepted. Never use "*".
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# Remember to never commit actual sensitive values to version control.
# Use this file as a template and create a .env file with real values for each environment.